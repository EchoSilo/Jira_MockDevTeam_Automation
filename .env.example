# Jira Configuration
JIRA_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your-api-token

# Jira Project
PROJECT_KEY=YOUR_PROJECT_KEY

# LLM API Keys
# Set the API key(s) for the provider(s) you want to use.
# The provider is determined by the model prefix in config/settings.yaml

# For Anthropic models (prefix: anthropic/)
ANTHROPIC_API_KEY=your-anthropic-api-key

# For OpenRouter models (prefix: openrouter/)
# Provides access to Claude, GPT-4, Llama, Mistral, and 100+ other models
# OPENROUTER_API_KEY=your-openrouter-api-key

# For OpenAI models (prefix: openai/)
# OPENAI_API_KEY=your-openai-api-key
