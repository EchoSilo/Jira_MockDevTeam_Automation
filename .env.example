# Jira Configuration
# Shared admin account: used for reads, health checks, sprint/release admin,
# and as the fallback when an agent has no per-agent credentials.
JIRA_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your-api-token

# Jira Project
PROJECT_KEY=YOUR_PROJECT_KEY

# Per-Agent Jira Attribution (optional)
# Give each simulated team member their own Jira account + API token so their
# issue-level actions (comments, transitions, work logs, assignments) are recorded
# in Jira under the correct person instead of the shared admin account above.
#
# Variable names are JIRA_EMAIL_<NAME> / JIRA_API_TOKEN_<NAME> where <NAME> is the
# agent's `display_name` from config/personas.yaml, UPPER_SNAKE_CASED
# (e.g. "James Park" -> JAMES_PARK). Any agent missing either var falls back to the
# shared admin account. The release_manager (Alex Thompson) intentionally has none.
#
# JIRA_EMAIL_SARAH_CHEN=
# JIRA_API_TOKEN_SARAH_CHEN=
# JIRA_EMAIL_MARCUS_JOHNSON=
# JIRA_API_TOKEN_MARCUS_JOHNSON=
# JIRA_EMAIL_ELENA_RODRIGUEZ=
# JIRA_API_TOKEN_ELENA_RODRIGUEZ=
# JIRA_EMAIL_JAMES_PARK=
# JIRA_API_TOKEN_JAMES_PARK=
# JIRA_EMAIL_PRIYA_SHARMA=
# JIRA_API_TOKEN_PRIYA_SHARMA=
# JIRA_EMAIL_DAVID_KIM=
# JIRA_API_TOKEN_DAVID_KIM=
# JIRA_EMAIL_ANA_COSTA=
# JIRA_API_TOKEN_ANA_COSTA=
# JIRA_EMAIL_TYLER_BROOKS=
# JIRA_API_TOKEN_TYLER_BROOKS=
# JIRA_EMAIL_RACHEL_GREEN=
# JIRA_API_TOKEN_RACHEL_GREEN=

# LLM API Keys
# Set the API key(s) for the provider(s) you want to use.
# The provider is determined by the model prefix in config/settings.yaml

# For Anthropic models (prefix: anthropic/)
ANTHROPIC_API_KEY=your-anthropic-api-key

# For OpenRouter models (prefix: openrouter/)
# Provides access to Claude, GPT-4, Llama, Mistral, and 100+ other models
# OPENROUTER_API_KEY=your-openrouter-api-key

# For OpenAI models (prefix: openai/)
# OPENAI_API_KEY=your-openai-api-key
